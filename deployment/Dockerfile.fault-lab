FROM python:3.11.13-slim-bookworm@sha256:cec9aa7aa96eea4fa036e9b82be1e6b325f2e3707f462d885868df51ec0a4b47

WORKDIR /workspace

RUN apt-get update \
    && apt-get install --yes --no-install-recommends docker.io ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY fault-lab/pyproject.toml fault-lab/uv.lock /workspace/fault-lab/
COPY fault-lab/src /workspace/fault-lab/src
COPY docs/design/contracts /workspace/docs/design/contracts

RUN python -m pip install --no-cache-dir /workspace/fault-lab

ENTRYPOINT ["fault-lab"]
