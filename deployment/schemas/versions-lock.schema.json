{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opspilot.local/schemas/versions-lock.schema.json",
  "title": "OpsPilot immutable version lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sourceCommit",
    "policy",
    "toolchain",
    "dependencies",
    "mavenPlugins",
    "supplyChainTools",
    "protocols",
    "containers",
    "chatModel",
    "models",
    "validator"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "sourceCommit": { "$ref": "#/$defs/gitRevision" },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["versionRangesAllowed", "mutableContainerTagsAllowed", "mutableModelRevisionsAllowed"],
      "properties": {
        "versionRangesAllowed": { "const": false },
        "mutableContainerTagsAllowed": { "const": false },
        "mutableModelRevisionsAllowed": { "const": false }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["javaRelease", "jdk", "maven"],
      "properties": {
        "javaRelease": { "const": 21 },
        "jdk": {
          "type": "object",
          "additionalProperties": false,
          "required": ["distribution", "version", "downloadSha256"],
          "properties": {
            "distribution": { "const": "Eclipse Temurin" },
            "version": { "pattern": "^21\\.[0-9]+\\.[0-9]+\\+[0-9]+$" },
            "downloadSha256": { "$ref": "#/$defs/sha256Hex" }
          }
        },
        "maven": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "wrapperVersion", "wrapperJarSha256"],
          "properties": {
            "version": { "$ref": "#/$defs/exactVersion" },
            "wrapperVersion": { "$ref": "#/$defs/exactVersion" },
            "wrapperJarSha256": { "$ref": "#/$defs/sha256Hex" }
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/dependency" }
    },
    "mavenPlugins": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/plugin" }
    },
    "supplyChainTools": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dockerSbom", "dockerScout"],
      "properties": {
        "dockerSbom": { "$ref": "#/$defs/exactVersion" },
        "dockerScout": { "$ref": "#/$defs/exactVersion" }
      }
    },
    "protocols": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "release", "sourceRevision", "wireProtocolVersion"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "release": { "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "sourceRevision": { "$ref": "#/$defs/gitRevision" },
          "wireProtocolVersion": { "pattern": "^[0-9]+\\.[0-9]+$" }
        }
      }
    },
    "containers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/container" }
    },
    "chatModel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "modelId", "revision"],
      "properties": {
        "provider": { "const": "deepseek" },
        "modelId": { "const": "deepseek-v4-flash" },
        "revision": { "const": "deepseek-v4-flash" }
      }
    },
    "models": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/model" }
    },
    "validator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python", "pyyaml", "jsonschema"],
      "properties": {
        "python": { "$ref": "#/$defs/exactVersion" },
        "pyyaml": { "$ref": "#/$defs/exactVersion" },
        "jsonschema": { "$ref": "#/$defs/exactVersion" }
      }
    }
  },
  "$defs": {
    "nonEmpty": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!.*(?:<[^>]+>|(?i:latest|placeholder|changeme|todo|tbd))).+$"
    },
    "exactVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[.-][A-Za-z0-9]+)*$"
    },
    "gitRevision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256Hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "coordinate": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+:[A-Za-z0-9_.-]+$"
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "coordinate", "version", "license"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmpty" },
        "coordinate": { "$ref": "#/$defs/coordinate" },
        "version": { "$ref": "#/$defs/exactVersion" },
        "sourceRevision": { "$ref": "#/$defs/gitRevision" },
        "license": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coordinate", "version"],
      "properties": {
        "coordinate": { "$ref": "#/$defs/coordinate" },
        "version": { "$ref": "#/$defs/exactVersion" }
      }
    },
    "container": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "immutableRef", "digest", "localImageId", "components"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmpty" },
        "immutableRef": {
          "type": "string",
          "pattern": "^[a-z0-9._/-]+@sha256:[0-9a-f]{64}$"
        },
        "digest": { "$ref": "#/$defs/digest" },
        "localImageId": { "$ref": "#/$defs/digest" },
        "components": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "modelId", "revision", "servedName", "task", "license"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmpty" },
        "modelId": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "revision": { "$ref": "#/$defs/gitRevision" },
        "servedName": { "$ref": "#/$defs/nonEmpty" },
        "task": { "enum": ["embedding", "rerank"] },
        "license": { "$ref": "#/$defs/nonEmpty" }
      }
    }
  }
}
