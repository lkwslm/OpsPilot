{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opspilot.local/schemas/a2a-skills/1.0.0",
  "title": "OpsPilot A2A Skill Payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "skillId", "incidentId", "runId", "stepId", "budget", "request"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "skillId": {"enum": ["incident-investigation", "collect-observability-evidence", "analyze-code-location", "retrieve-incident-knowledge", "generate-and-verify-hypotheses", "propose-remediation"]},
    "incidentId": {"type": "string", "format": "uuid"},
    "runId": {"type": "string", "format": "uuid"},
    "stepId": {"type": "string", "format": "uuid"},
    "budget": {"$ref": "#/$defs/budget"},
    "request": {"type": "object"},
    "result": {"type": "object"}
  },
  "allOf": [
    {"if": {"properties": {"skillId": {"const": "incident-investigation"}}}, "then": {"properties": {"request": {"$ref": "#/$defs/investigationRequest"}, "result": {"$ref": "#/$defs/investigationResult"}}}},
    {"if": {"properties": {"skillId": {"const": "collect-observability-evidence"}}}, "then": {"properties": {"request": {"$ref": "#/$defs/evidenceRequest"}, "result": {"$ref": "#/$defs/evidenceResult"}}}},
    {"if": {"properties": {"skillId": {"const": "analyze-code-location"}}}, "then": {"properties": {"request": {"$ref": "#/$defs/codeRequest"}, "result": {"$ref": "#/$defs/codeResult"}}}},
    {"if": {"properties": {"skillId": {"const": "retrieve-incident-knowledge"}}}, "then": {"properties": {"request": {"$ref": "#/$defs/knowledgeRequest"}, "result": {"$ref": "#/$defs/knowledgeResult"}}}},
    {"if": {"properties": {"skillId": {"const": "generate-and-verify-hypotheses"}}}, "then": {"properties": {"request": {"$ref": "#/$defs/diagnosisRequest"}, "result": {"$ref": "#/$defs/diagnosisResult"}}}},
    {"if": {"properties": {"skillId": {"const": "propose-remediation"}}}, "then": {"properties": {"request": {"$ref": "#/$defs/remediationRequest"}, "result": {"$ref": "#/$defs/remediationResult"}}}}
  ],
  "$defs": {
    "uuid": {"type": "string", "format": "uuid"},
    "refs": {"type": "array", "maxItems": 500, "uniqueItems": true, "items": {"$ref": "#/$defs/uuid"}},
    "budget": {"type": "object", "additionalProperties": false, "required": ["deadline", "maxRounds", "maxToolCalls", "maxTokens"], "properties": {"deadline": {"type": "string", "format": "date-time"}, "maxRounds": {"type": "integer", "minimum": 1, "maximum": 50}, "maxToolCalls": {"type": "integer", "minimum": 0, "maximum": 100}, "maxTokens": {"type": "integer", "minimum": 1}}},
    "investigationRequest": {"type": "object", "additionalProperties": false, "required": ["ticketArtifactId", "inputArtifactIds", "constraints"], "properties": {"ticketArtifactId": {"$ref": "#/$defs/uuid"}, "inputArtifactIds": {"$ref": "#/$defs/refs"}, "constraints": {"type": "object", "additionalProperties": true}}},
    "investigationResult": {"type": "object", "additionalProperties": false, "required": ["planArtifactId", "rcaArtifactId", "outcome"], "properties": {"planArtifactId": {"$ref": "#/$defs/uuid"}, "rcaArtifactId": {"$ref": "#/$defs/uuid"}, "outcome": {"enum": ["CONCLUSIVE", "PARTIAL", "INCONCLUSIVE"]}}},
    "evidenceRequest": {"type": "object", "additionalProperties": false, "required": ["systems", "resources", "start", "end", "requiredSignals"], "properties": {"systems": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "resources": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "start": {"type": "string", "format": "date-time"}, "end": {"type": "string", "format": "date-time"}, "requiredSignals": {"type": "array", "items": {"enum": ["LOG", "METRIC", "TRACE", "EVENT", "HEALTH", "CONFIG", "TOPOLOGY"]}}}},
    "evidenceResult": {"type": "object", "additionalProperties": false, "required": ["observationBatchIds", "evidenceBundleArtifactId", "evidenceIds", "missingEvidenceCodes"], "properties": {"observationBatchIds": {"$ref": "#/$defs/refs"}, "evidenceBundleArtifactId": {"$ref": "#/$defs/uuid"}, "evidenceIds": {"$ref": "#/$defs/refs"}, "missingEvidenceCodes": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}}},
    "codeRequest": {"type": "object", "additionalProperties": false, "required": ["repositoryId", "evidenceIds", "symbols"], "properties": {"repositoryId": {"type": "string"}, "evidenceIds": {"$ref": "#/$defs/refs"}, "symbols": {"type": "array", "maxItems": 100, "items": {"type": "string"}}}},
    "codeResult": {"type": "object", "additionalProperties": false, "required": ["findingArtifactId", "evidenceBundleArtifactId", "evidenceIds"], "properties": {"findingArtifactId": {"$ref": "#/$defs/uuid"}, "evidenceBundleArtifactId": {"$ref": "#/$defs/uuid"}, "evidenceIds": {"$ref": "#/$defs/refs"}}},
    "knowledgeRequest": {"type": "object", "additionalProperties": false, "required": ["collectionId", "queries", "filters"], "properties": {"collectionId": {"$ref": "#/$defs/uuid"}, "queries": {"type": "array", "minItems": 1, "maxItems": 10, "items": {"type": "string", "maxLength": 4000}}, "filters": {"type": "object", "additionalProperties": true}}},
    "knowledgeResult": {"type": "object", "additionalProperties": false, "required": ["outcome", "referenceIds", "rerankApplied", "evidenceBundleArtifactId", "evidenceIds"], "properties": {"outcome": {"enum": ["MATCH", "NO_MATCH", "KB_EMPTY"]}, "referenceIds": {"$ref": "#/$defs/refs"}, "rerankApplied": {"type": "boolean"}, "evidenceBundleArtifactId": {"oneOf": [{"$ref": "#/$defs/uuid"}, {"type": "null"}]}, "evidenceIds": {"$ref": "#/$defs/refs"}}},
    "diagnosisRequest": {"type": "object", "additionalProperties": false, "required": ["evidenceIds"], "properties": {"evidenceIds": {"$ref": "#/$defs/refs"}}},
    "diagnosisResult": {"type": "object", "additionalProperties": false, "required": ["hypothesisIds", "assessmentArtifactId", "outcome"], "properties": {"hypothesisIds": {"$ref": "#/$defs/refs"}, "assessmentArtifactId": {"$ref": "#/$defs/uuid"}, "outcome": {"enum": ["CONCLUSIVE", "PARTIAL", "INCONCLUSIVE", "INPUT_REQUIRED"]}}},
    "remediationRequest": {"type": "object", "additionalProperties": false, "required": ["diagnosisArtifactId", "allowedActionCodes"], "properties": {"diagnosisArtifactId": {"$ref": "#/$defs/uuid"}, "allowedActionCodes": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}}},
    "remediationResult": {"type": "object", "additionalProperties": false, "required": ["remediationArtifactId", "approvalRequired"], "properties": {"remediationArtifactId": {"$ref": "#/$defs/uuid"}, "approvalRequired": {"type": "boolean"}, "requestedTestSuiteId": {"type": ["string", "null"]}}}
  }
}
