{
  "schemaVersion": "1.0.0",
  "profileId": "remediation-default",
  "profileVersion": "1.0.0",
  "role": "REMEDIATION",
  "skillId": "propose-remediation",
  "description": "Proposes evidence-linked remediation and may request an approved bounded test.",
  "prompt": {"templateId": "remediation-v1", "templateVersion": "1.0.0", "systemPolicyTemplateId": "opspilot-system-policy-v1"},
  "model": {"modelProfileRef": "reasoning-high", "requiredCapabilities": ["TOOL_CALLS", "STRUCTURED_OUTPUT"], "generation": {"temperature": 0.1, "maxOutputTokens": 3072, "timeoutMs": 60000}},
  "inputContract": {"schemaId": "https://opspilot.local/schemas/a2a-skills/1.0.0#/$defs/remediationRequest", "mediaType": "application/vnd.opspilot.propose-remediation.request+json;v=1"},
  "outputContract": {"schemaId": "https://opspilot.local/schemas/a2a-skills/1.0.0#/$defs/remediationResult", "mediaType": "application/vnd.opspilot.propose-remediation.result+json;v=1"},
  "contextPolicy": {"allowedInputs": ["INCIDENT", "EVIDENCE", "ARTIFACT", "TASK_STATE", "APPROVAL"], "factsFromEvidenceOnly": true, "maxEvidenceItems": 500, "maxArtifactBytes": 10485760},
  "toolPolicy": {"allowedTools": [{"toolId": "SandboxTestTool", "contractMajor": 1}], "maxPermission": "CONTROLLED_EXECUTION", "maxCalls": 1, "dynamicDiscovery": false},
  "a2aPolicy": {"allowedSkills": [], "maxDelegations": 0, "peerToPeerDelegation": false},
  "budget": {"maxTurns": 10, "maxModelCalls": 10, "maxToolCalls": 1, "maxInputTokensPerCall": 16000, "maxOutputTokensPerCall": 3072, "maxTaskTokens": 40000, "deadlineSeconds": 900},
  "sandboxPolicy": {"mode": "APPROVED_TEST", "runnerRef": "maven-sandbox-v1", "requireApproval": true, "allowedTestSuiteIds": ["opspilot-regression-v1"], "networkAccess": "DENY", "writableRoots": ["/workspace/target"], "limits": {"maxDurationSeconds": 300, "maxCpu": 2, "maxMemoryMb": 2048}},
  "securityPolicy": {"policyRef": "remediation-controlled-test-v1", "resourceScopes": ["incident:${incidentId}", "run:${runId}", "repository:${repositoryId}"], "maxDataClassification": "CONFIDENTIAL", "groundTruthAccess": false, "secretAccess": false, "arbitraryCommandExecution": false, "codeMutation": false},
  "terminationPolicy": {"completionConditions": ["RESULT_SCHEMA_VALID", "EVIDENCE_THRESHOLD_MET", "NO_PROGRESS", "BUDGET_EXHAUSTED", "INPUT_REQUIRED", "CANCELLED"], "noProgressRounds": 2, "resultMapperRef": "remediation-result-mapper-v1"}
}
